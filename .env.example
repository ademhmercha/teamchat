# TeamChat - exemple de variables d'environnement.
# Copier en `.env` (jamais committe) et renseigner les valeurs.
# Les valeurs ci-dessous sont des placeholders sans secret reel.

# Base de donnees PostgreSQL (provider Npgsql)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=teamchat;Username=teamchat;Password=change-me

# JWT
Jwt__Issuer=teamchat
Jwt__Audience=teamchat
Jwt__Secret=change-me-please-use-a-long-random-secret-min-32-chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Google (connexion via ID token)
Google__ClientId=

# CORS (domaines autorises, separes par des virgules)
Cors__AllowedOrigins=http://localhost:4200

# Cache. Redis__ConnectionString vide = cache memoire seul (L1 uniquement)
Redis__ConnectionString=
Cache__DefaultTtlSeconds=60

# Stockage des fichiers
Storage__Provider=Local
Storage__LocalPath=uploads
Storage__MaxFileSizeBytes=26214400
Storage__MaxVoiceSizeBytes=10485760
Storage__S3__Endpoint=
Storage__S3__Bucket=
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__Region=us-east-1
Storage__S3__ForcePathStyle=true

# TURN (appels WebRTC)
Turn__Urls=
Turn__Secret=

# Compte admin initial (seed). Ne jamais committer de mot de passe reel.
Admin__SeedEmail=
Admin__SeedPassword=
