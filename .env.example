# TeamChat - exemple de variables d'environnement.
# Copier en `.env` (jamais committe) et renseigner les valeurs.
# Les valeurs ci-dessous sont des placeholders sans secret reel.

# Base de donnees PostgreSQL (provider Npgsql)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=teamchat;Username=teamchat;Password=change-me

# JWT
Jwt__Issuer=teamchat
Jwt__Audience=teamchat
Jwt__Secret=change-me-please-use-a-long-random-secret-min-32-chars
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# Google (connexion via ID token)
Google__ClientId=

# CORS (domaines autorises, separes par des virgules)
Cors__AllowedOrigins=http://localhost:4200

# Cache. Redis__ConnectionString vide = cache memoire seul (L1 uniquement).
# Si renseignee : cache L2 Redis + backplane SignalR Redis (multi-instances).
Redis__ConnectionString=
Cache__DefaultTtlSeconds=60

# Stockage des fichiers
Storage__Provider=Local
Storage__LocalPath=uploads
Storage__MaxFileSizeBytes=26214400
Storage__MaxVoiceSizeBytes=10485760
Storage__S3__Endpoint=
Storage__S3__Bucket=
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__Region=us-east-1
Storage__S3__ForcePathStyle=true

# Appels WebRTC - serveurs ICE.
# STUN public par defaut ; renseigner TURN pour les reseaux stricts (NAT symetrique).
# Turn__Urls vide = STUN uniquement (pas de relais). Plusieurs URLs se separent par des virgules.
#
# `Turn__Urls` doit etre joignable par le NAVIGATEUR (ex. turn:localhost:3478 en local,
# turn:mon-domaine.com:3478 en prod). `Turn__Secret` doit etre identique au secret
# `--static-auth-secret` de coturn (voir `TURN_SECRET` ci-dessous) : l'API genere alors
# des identifiants TURN temporaires (mecanisme "TURN REST API").
Turn__Urls=
Turn__Secret=

# Coturn (docker compose, profil `turn`). TURN_URLS est l'URL publique distribuee au
# navigateur ; mettre une IP/domaine public en production.
TURN_SECRET=teamchat_turn_dev_only
TURN_REALM=teamchat.local
TURN_PORT=3478
TURN_URLS=turn:localhost:3478

# Appels : delai avant expiration d'une sonnerie (s) et periode de balayage (s).
Calls__RingingTimeoutSeconds=30
Calls__SweepSeconds=5

# Compte admin initial (seed). Ne jamais committer de mot de passe reel.
Admin__SeedEmail=
Admin__SeedPassword=
